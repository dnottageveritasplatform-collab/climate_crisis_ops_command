{
  "name": "climate-crisis-ops-command",
  "version": "0.1.0",
  "private": true,
  "description": "Future Caribbean 2026 - Veritas-powered post-storm coordination command",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "spike:monitor": "node -e \"import('./src/agents/monitor/brief.js').then(m=>m.runMonitorBrief()).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "brief:monitor": "node -e \"import('./src/agents/monitor/brief.js').then(m=>m.runMonitorBrief()).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "demo:week1": "node -e \"import('./src/demo/week1.js').then(m=>m.runWeek1Demo()).then(r=>console.log(JSON.stringify({ok:r.ok,exitCriteria:r.exitCriteria,auditId:r.audit?.id,briefLevel:r.monitor?.brief?.level,mapAtRisk:r.map?.atRiskCount},null,2)))\"",
    "triage:rank": "node -e \"import('./src/agents/triage/rank.js').then(m=>m.runTriageRank()).then(r=>console.log(JSON.stringify({ok:true,topTrip:r.ranking.rankedTrips[0],conflicts:r.ranking.corridorConflicts,mapSync:r.map?.syncSource,atRisk:r.map?.atRiskCount},null,2)))\"",
    "action:pack": "node -e \"import('./src/agents/action/pack.js').then(m=>m.runActionPack()).then(r=>console.log(JSON.stringify({ok:true,checklist:r.pack.checklist.length,bulletin:r.pack.hospitalBulletin.subject,driverComms:r.pack.driverComms.length},null,2)))\"",
    "pipeline:run": "node -e \"import('./src/orchestrator/index.js').then(m=>m.runPipeline()).then(r=>console.log(JSON.stringify({ok:r.ok,pipelineId:r.pipelineId,threshold:r.threshold,hitlGate:r.hitlGate,ranked:r.triage.ranking.rankedTrips.length,checklist:r.action.pack.checklist.length},null,2)))\"",
    "audit:trail": "node -e \"import('./src/audit/index.js').then(async m=>{const {runPipeline}=await import('./src/orchestrator/index.js');await runPipeline();console.log(JSON.stringify(m.buildAuditTrail(8),null,2))})\"",
    "eval:run": "node -e \"import('./src/eval/index.js').then(m=>m.runEvalSuite({skipLlm:true})).then(r=>console.log(JSON.stringify({ok:r.ok,summary:r.summary,totalLatencyMs:r.totalLatencyMs,failed:r.results.filter(x=>!x.passed).map(x=>x.scenarioId)},null,2)))\"",
    "efficiency:summary": "node -e \"import('./src/efficiency/index.js').then(m=>console.log(JSON.stringify(m.buildEfficiencySummary(),null,2)))\"",
    "efficiency:pipeline": "node -e \"import('./src/orchestrator/index.js').then(m=>m.runPipeline()).then(r=>console.log(JSON.stringify({ok:r.ok,pipelineId:r.pipelineId,efficiency:r.efficiency,modes:{monitor:r.monitor?.mode,triage:r.triage?.mode,action:r.action?.mode}},null,2)))\"",
    "demo:rehearsal": "node -e \"import('./src/demo/rehearsal.js').then(m=>console.log(m.formatRehearsalScriptText(m.buildRehearsalScript())))\"",
    "defensibility:summary": "node -e \"import('./src/defensibility/index.js').then(m=>console.log(JSON.stringify(m.buildDefensibilitySummary(),null,2)))\"",
    "deploy:check": "node -e \"import('./src/deploy/index.js').then(m=>console.log(JSON.stringify(m.buildDeployChecklist(),null,2)))\"",
    "docker:build": "docker build -t ccoc:staging .",
    "demo:video": "node scripts/build-demo-video.mjs",
    "logbook:week3": "node -e \"import('./src/logbook/index.js').then(m=>console.log(m.formatLogbookWeek3Text()))\"",
    "mentor:questions": "node -e \"import('./src/logbook/index.js').then(m=>console.log(m.formatMentorQuestionsText()))\"",
    "demo:preflight": "node -e \"import('./src/demo/day21.js').then(m=>m.runDemoDayPreflight()).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "demo:runbook": "node -e \"import('./src/demo/day21.js').then(m=>console.log(m.formatDemoDayRunbookText()))\"",
    "demo:qa": "node -e \"import('./src/demo/day21.js').then(m=>console.log(m.formatQaPrepText()))\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "csv-parse": "^5.6.0"
  }
}
