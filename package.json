{
  "name": "climate-crisis-ops-command",
  "version": "0.1.0",
  "private": true,
  "description": "Future Caribbean 2026 - Veritas-powered post-storm coordination command",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "spike:monitor": "node -e \"import('./src/agents/monitor/brief.js').then(m=>m.runMonitorBrief()).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "brief:monitor": "node -e \"import('./src/agents/monitor/brief.js').then(m=>m.runMonitorBrief()).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "demo:week1": "node -e \"import('./src/demo/week1.js').then(m=>m.runWeek1Demo()).then(r=>console.log(JSON.stringify({ok:r.ok,exitCriteria:r.exitCriteria,auditId:r.audit?.id,briefLevel:r.monitor?.brief?.level,mapAtRisk:r.map?.atRiskCount},null,2)))\"",
    "triage:rank": "node -e \"import('./src/agents/triage/rank.js').then(m=>m.runTriageRank()).then(r=>console.log(JSON.stringify({ok:true,topTrip:r.ranking.rankedTrips[0],conflicts:r.ranking.corridorConflicts,mapSync:r.map?.syncSource,atRisk:r.map?.atRiskCount},null,2)))\"",
    "action:pack": "node -e \"import('./src/agents/action/pack.js').then(m=>m.runActionPack()).then(r=>console.log(JSON.stringify({ok:true,checklist:r.pack.checklist.length,bulletin:r.pack.hospitalBulletin.subject,driverComms:r.pack.driverComms.length},null,2)))\"",
    "pipeline:run": "node -e \"import('./src/orchestrator/index.js').then(m=>m.runPipeline()).then(r=>console.log(JSON.stringify({ok:r.ok,pipelineId:r.pipelineId,threshold:r.threshold,hitlGate:r.hitlGate,ranked:r.triage.ranking.rankedTrips.length,checklist:r.action.pack.checklist.length},null,2)))\"",
    "audit:trail": "node -e \"import('./src/audit/index.js').then(async m=>{const {runPipeline}=await import('./src/orchestrator/index.js');await runPipeline();console.log(JSON.stringify(m.buildAuditTrail(8),null,2))})\"",
    "eval:run": "node -e \"import('./src/eval/index.js').then(m=>m.runEvalSuite({skipLlm:true})).then(r=>console.log(JSON.stringify({ok:r.ok,summary:r.summary,totalLatencyMs:r.totalLatencyMs,failed:r.results.filter(x=>!x.passed).map(x=>x.scenarioId)},null,2)))\"",
    "efficiency:summary": "node -e \"import('./src/efficiency/index.js').then(m=>console.log(JSON.stringify(m.buildEfficiencySummary(),null,2)))\"",
    "efficiency:pipeline": "node -e \"import('./src/orchestrator/index.js').then(m=>m.runPipeline()).then(r=>console.log(JSON.stringify({ok:r.ok,pipelineId:r.pipelineId,efficiency:r.efficiency,modes:{monitor:r.monitor?.mode,triage:r.triage?.mode,action:r.action?.mode}},null,2)))\"",
    "demo:rehearsal": "node -e \"import('./src/demo/rehearsal.js').then(m=>console.log(m.formatRehearsalScriptText(m.buildRehearsalScript())))\"",
    "defensibility:summary": "node -e \"import('./src/defensibility/index.js').then(m=>console.log(JSON.stringify(m.buildDefensibilitySummary(),null,2)))\"",
    "deploy:check": "node -e \"import('./src/deploy/index.js').then(m=>console.log(JSON.stringify(m.buildDeployChecklist(),null,2)))\"",
    "docker:build": "docker build -t ccoc:staging .",
    "demo:video": "node scripts/build-demo-video.mjs",
    "logbook:week3": "node -e \"import('./src/logbook/index.js').then(m=>console.log(m.formatLogbookWeek3Text()))\"",
    "mentor:questions": "node -e \"import('./src/logbook/index.js').then(m=>console.log(m.formatMentorQuestionsText()))\"",
    "demo:preflight": "node -e \"import('./src/demo/day21.js').then(m=>m.runDemoDayPreflight()).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "demo:runbook": "node -e \"import('./src/demo/day21.js').then(m=>console.log(m.formatDemoDayRunbookText()))\"",
    "demo:qa": "node -e \"import('./src/demo/day21.js').then(m=>console.log(m.formatQaPrepText()))\"",
    "cad:summary": "node -e \"import('./src/cad/index.js').then(m=>console.log(JSON.stringify(m.buildCadSummary(2),null,2)))\"",
    "cad:cross-ref": "node -e \"import('./src/cad/index.js').then(m=>console.log(JSON.stringify(m.buildCadCrossReference(2),null,2)))\"",
    "transport-desk:summary": "node -e \"import('./src/transport-desk/index.js').then(m=>console.log(JSON.stringify(m.buildTransportDeskSummary(2),null,2)))\"",
    "transport-desk:cross-ref": "node -e \"import('./src/transport-desk/index.js').then(m=>console.log(JSON.stringify(m.buildHandoffCrossReference(2),null,2)))\"",
    "public-safety:summary": "node -e \"import('./src/public-safety/index.js').then(m=>console.log(JSON.stringify(m.buildPublicSafetySummary(2),null,2)))\"",
    "public-safety:cross-ref": "node -e \"import('./src/public-safety/index.js').then(m=>console.log(JSON.stringify(m.buildPublicSafetyCorridorCrossRef(2),null,2)))\"",
    "public-safety:cop-export": "node -e \"import('./src/public-safety/index.js').then(async m=>console.log(JSON.stringify(await m.buildCopExport(2),null,2)))\"",
    "transport-desk:accept-demo": "node -e \"import('./src/transport-desk/index.js').then(m=>{m.ingestTransportDeskFeed();console.log(JSON.stringify(m.acceptNemtHandoffWriteBack([{handoffId:'HO-2201',status:'nemt_assigned',nemtRunId:'RUN-8845',linkedTripId:'T-1004'}],{source:'cli_demo'}),null,2))})\"",
    "cad:enriched-dispatch": "node -e \"import('./src/cad/enrichment.js').then(m=>console.log(JSON.stringify(m.buildEnrichedDispatchSummary(2),null,2)))\"",
    "geo:corridors-esri": "node -e \"import('./src/geo/esri.js').then(m=>console.log(JSON.stringify(m.buildEsriCorridorSummary(2),null,2)))\"",
    "geo:corridors-source": "node -e \"import('./src/geo/esri.js').then(m=>console.log(JSON.stringify(m.getCorridorLayerMeta(),null,2)))\"",
    "geo:routing-preview": "node -e \"import('./src/geo/routing.js').then(m=>console.log(JSON.stringify(m.buildRoutingPreviewSummary(2),null,2)))\"",
    "geo:routing-cross-ref": "node -e \"import('./src/geo/routing.js').then(m=>console.log(JSON.stringify(m.buildRoutingPreviewCrossRef(2),null,2)))\"",
    "shelter-fleet:summary": "node -e \"import('./src/shelter-fleet/index.js').then(m=>console.log(JSON.stringify(m.buildShelterFleetSummary(2),null,2)))\"",
    "shelter-fleet:cross-ref": "node -e \"import('./src/shelter-fleet/index.js').then(m=>console.log(JSON.stringify(m.buildShelterFleetCrossRef(2),null,2)))\"",
    "audit:persist": "node -e \"import('./src/audit/index.js').then(m=>console.log(JSON.stringify(m.getAuditPersistStatus(),null,2)))\"",
    "audit:eoc-briefing": "node -e \"import('./src/audit/eoc-export.js').then(m=>m.buildEocAuditBriefing({level:2})).then(r=>console.log(JSON.stringify({ok:r.ok,exportType:r.exportType,persist:r.persist,summary:r.summary},null,2)))\"",
    "signals:multi-feed": "node -e \"import('./src/signals/multi-feed.js').then(m=>console.log(JSON.stringify(m.buildMultiFeedSummary(2),null,2)))\"",
    "signals:cross-ref": "node -e \"import('./src/signals/multi-feed.js').then(m=>console.log(JSON.stringify(m.buildMultiFeedCrossRef(2),null,2)))\"",
    "signals:sources": "node -e \"import('./src/signals/multi-feed.js').then(m=>m.getMultiFeedSources()).then(r=>console.log(JSON.stringify(r,null,2)))\"",
    "sops:corpus": "node -e \"import('./src/sops/corpus.js').then(m=>console.log(JSON.stringify(m.buildSopCorpusSummary(),null,2)))\"",
    "sops:cross-ref": "node -e \"import('./src/sops/corpus.js').then(m=>console.log(JSON.stringify(m.buildSopCorpusCrossRef(2),null,2)))\"",
    "sops:search": "node -e \"import('./src/sops/index.js').then(m=>console.log(JSON.stringify(m.querySopCorpus('shelter coordinator',{mode:'hybrid'}),null,2)))\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "csv-parse": "^5.6.0"
  }
}
