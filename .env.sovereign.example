# Sovereign on-prem deploy — Caribbean operator data residency (Phase 2 Day 15)
# Copy to .env on edge VM / hospital NOC host. No external LLM keys required.

PORT=8787
NODE_ENV=production

# Air-gapped friendly — zero outbound LLM API calls
DEMO_MODE=true

# Local append-only audit trail (mount data/ volume in docker-compose.sovereign.yml)
AUDIT_PERSIST=true
# AUDIT_PERSIST_PATH=data/audit-trail.jsonl

# Demo storm signals — disable live NHC fetch for fully offline edge
NHC_LIVE=false

# Optional: agency GIS file paths (defaults to data/geo/*-demo.json)
# FLOOD_DEPTH_PATH=data/geo/flood-depth-demo.json
# WIND_EXPOSURE_PATH=data/geo/wind-exposure-demo.json
# ROUTING_ALTERNATES_PATH=data/geo/routing-alternates-demo.json
# ESRI_USE_STATIC=true

# Optional outbound feeds (leave unset for sovereign pilot)
# NHC_FEED_URL=
# LLM_PROVIDER=
# LLM_API_KEY=

# Phase 3 Day 9 — GloFAS air-gap bundle (pre-download clip; no CDS at runtime)
# GLOFAS_ENABLED=true
# GLOFAS_AIRGAP=true
# GLOFAS_LIVE=false
# GLOFAS_DEMO=false
# GLOFAS_CLIP_PATH=data/geo/glofas-nassau-latest.json

# Phase 3b Day 9 — commercial urban flood air-gap bundle (pre-download clip; no vendor API at runtime)
# URBAN_FLOOD_ENABLED=true
# URBAN_FLOOD_AIRGAP=true
# URBAN_FLOOD_LIVE=false
# URBAN_FLOOD_DEMO=false
# URBAN_FLOOD_CLIP_PATH=data/geo/urban-flood-nassau-latest.json
