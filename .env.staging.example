# Staging deploy — copy to platform env vars (do not commit secrets)

PORT=8787
NODE_ENV=production

# Recommended for public staging URL (fast, reliable, zero LLM cost)
DEMO_MODE=true

# Optional live NHC headline overlay (works in demo mode)
NHC_FEED_URL=https://www.nhc.noaa.gov/xml/TWOAT.xml

# Optional LLM for staging demos (Groq recommended for speed)
# DEMO_MODE=false
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Optional HighRise H200 inference (Future Caribbean partner — see docs/highrise-compute.md)
# DEMO_MODE=false
# LLM_PROVIDER=highrise
# LLM_BASE_URL=https://YOUR-HIGHRISE-HOST/api/v1/ai
# LLM_API_KEY=
# LLM_MODEL=your-deployed-model-name
