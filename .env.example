# Climate & Crisis Ops Command - copy to .env and fill in

PORT=8787
NODE_ENV=development
DEMO_MODE=true

# --- LLM (pick ONE approach) ---
# Demo mode (free, no API): leave all LLM vars commented out

# OpenAI (paid credits required)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Groq free tier — https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama local (free, runs on your PC) — https://ollama.com
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2

# Optional signal feeds (Week 1 Day 3+)
# Atlantic Tropical Weather Outlook — good default; always has content
NHC_FEED_URL=https://www.nhc.noaa.gov/xml/TWOAT.xml
# Alternatives:
# NHC_FEED_URL=https://www.nhc.noaa.gov/index-at.xml
# NHC_FEED_URL=https://www.nhc.noaa.gov/xml/OFFNT3.xml
