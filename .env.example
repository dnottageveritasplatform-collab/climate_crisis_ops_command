# Climate & Crisis Ops Command - copy to .env and fill in

PORT=8787
NODE_ENV=development
DEMO_MODE=true

# --- LLM (pick ONE approach) ---
# Demo mode (free, no API): leave all LLM vars commented out

# OpenAI (paid credits required)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Groq free tier — https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# MiniMax keys (see docs/MINIMAX.txt):
#   sk-api-...  = pay-as-you-go (needs Billing > Balance credits)
#   sk-cp-...   = Monthly Max / Token Plan subscription quota
# For this Express app with Monthly Max, use sk-cp- in LLM_API_KEY.
# DEMO_MODE=false
# LLM_PROVIDER=minimax
# LLM_BASE_URL=https://api.minimax.io/v1
# LLM_API_KEY=sk-cp-your-subscription-key-here
# LLM_MODEL=MiniMax-M2.7-highspeed
# Models: M2.7-highspeed = live demos (fast); M3 = capture/rehearsal when you want richer COMMS-03 prose

# Ollama local (free, runs on your PC) — https://ollama.com
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2

# Optional signal feeds (Week 1 Day 3+)
# Atlantic Tropical Weather Outlook — good default; always has content
NHC_FEED_URL=https://www.nhc.noaa.gov/xml/TWOAT.xml

# Phase 2 Day 1 — CAD read-only overlay (optional)
# CAD_CSV_PATH=data/sample-cad-export.csv
# CAD_FEED_URL=   # future REST adapter when pilot agency provides endpoint

# Phase 2 Day 2 — EMS-adjacent transport desk (optional)
# HOSPITAL_DESK_PATH=data/sample-hospital-desk.json
# EMS_HANDOFF_PATH=data/sample-ems-handoff-queue.json
# TRANSPORT_DESK_URL=   # future REST adapter when pilot hospital provides endpoint
# NEMT_WRITEBACK_ENABLED=true   # Phase 2 Day 4 pilot handoff accept (default on in demo)

# Phase 2 Day 3 — fire / police EOC overlay (optional)
# PUBLIC_SAFETY_PATH=data/sample-public-safety-units.json
# PUBLIC_SAFETY_URL=   # future REST adapter when pilot EOC provides endpoint

# Phase 2 Day 6 — ESRI / agency GIS corridor layer (optional)
# ESRI_CORRIDOR_PATH=data/geo/esri-corridors-demo.json
# ESRI_CORRIDOR_URL=   # future REST adapter when pilot agency provides FeatureServer URL
# ESRI_USE_STATIC=true   # fallback to static corridors.json instead of ESRI demo layer

# Phase 2 Day 7 — shelter + fleet coordination (optional)
# SHELTER_FLEET_PATH=data/sample-shelter-fleet.json
# SHELTER_FLEET_URL=   # future REST adapter when pilot provides endpoint

# Phase 2 Day 8 — persistent audit + EOC export (optional)
# AUDIT_PERSIST_PATH=data/audit-trail.jsonl
# AUDIT_PERSIST=false   # disable JSONL persistence (in-memory only)

# Phase 2 Day 9 — multi-feed signal ingest (optional)
# INSTITUTIONAL_FEED_PATH=data/signals/institutional-feed-demo.json
# INSTITUTIONAL_FEED_URL=   # future REST adapter when pilot provides institutional feed endpoint
# Alternatives:
# NHC_FEED_URL=https://www.nhc.noaa.gov/index-at.xml
# NHC_FEED_URL=https://www.nhc.noaa.gov/xml/OFFNT3.xml
